<?php
$supabaseUrl = 'https://nnrjievanuqlealabihr.supabase.co';
$supabaseKey = 'YOUR_ANON_KEY';

function supabaseRequest($method, $endpoint, $data = null, $supabaseUrl, $supabaseKey) {
    $url = $supabaseUrl . '/rest/v1/' . $endpoint;
    $headers = [
        'apikey: ' . $supabaseKey,
        'Authorization: Bearer ' . $supabaseKey,
        'Content-Type: application/json',
        'Prefer: return=representation'
    ];
    $ch = curl_init($url);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
    curl_setopt($ch, CURLOPT_CUSTOMREQUEST, $method);
    if ($data !== null) {
        curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
    }
    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    return [
        'code' => $httpCode,
        'data' => json_decode($response, true)
    ];
}

function getAccounts($supabaseUrl, $supabaseKey) {
    return supabaseRequest('GET', 'vkb_accounts?select=*', null, $supabaseUrl, $supabaseKey);
}

// Run it and output JSON
$result = getAccounts($supabaseUrl, $supabaseKey);
header('Content-Type: application/json');
echo json_encode($result['data']);
?>
